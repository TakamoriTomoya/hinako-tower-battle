# オンライン対戦(合言葉で対戦)機能を使うには、Firebaseプロジェクトを作成し、
# Realtime Databaseを有効にした上で、Web用アプリのconfigをここにコピーして
# .env.local という名前で保存してください(.env.localは.gitignore対象です)。
# Vercelにデプロイする場合は、同じ値をVercelのプロジェクト環境変数にも設定してください。
#
# パスプレイ(1端末での対戦)のみ使う場合は、この設定は不要です。

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
